# LP直下のHTMLはキャッシュ再検証を必須にする（2026-07-08）
# 背景: LINE等のアプリ内ブラウザが古いHTMLをキャッシュ配信し、修正が実機に届かない事象が再発
# （インシデント「?v=を上げたのに効かない」と同型のHTML版）。アセットは ?v= 管理＋immutable
# なので、HTMLだけ no-cache にすれば以後の修正は ETag 再検証（304）で数分以内に必ず行き渡る。
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# JS/CSS は ?v= で版管理しているので長期キャッシュしてよい（2026-08-23）
# 背景: これまでアセットのキャッシュ指定が一切無く、ブラウザのヒューリスティック
# キャッシュ任せだった。「?v= を上げたのに効かない」事故が起きる一方で再訪時の高速化は
# 得られない、という一番損な状態。HTMLは上の no-cache で必ず再検証されるので、
# 新しい ?v= は即座に行き渡る。
#
# 前提（崩すと古いJS/CSSが1年配られ続ける）:
#   ・HTMLから参照されるローカルJS/CSSは必ず ?v= を持つ
#   ・中身を変えたら ?v= を上げる
# この2点は scripts/check-asset-versions.mjs が CI で機械的に止める。
#
# 画像とJSONは対象外。画像はデプロイ時に optimize-images.mjs が再圧縮して
# バイト列が変わり、booking-slots.json は定期同期で中身が変わるため
# （どちらも ?v= を持たないので immutable にすると凍る）。
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # 遅延ステップ steps-lazy.html は HTML だが「JSが ?v= 付きで fetch するアセット」であり、
  # ?v= は check-asset-versions.mjs の台帳で中身のハッシュと突き合わせている。
  # 上の .html no-cache のままだと再訪ごとに再検証（往復1回・~4KB）になるため
  # JS/CSS と同じ長期キャッシュにする（2026-09-04 高速化）。後勝ちなので上の .html より後に置く。
  <FilesMatch "^steps-lazy\.html$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# テキスト系の圧縮配信（2026-08-19 軽量化）
# HTML/CSS/JS/JSON/SVG を gzip（対応していれば brotli）で転送し、転送量を50〜70%削減する。
# 画像（webp/jpg/png）は圧縮済みフォーマットのため対象外。IfModuleガード付きで未対応環境でも無害。
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
